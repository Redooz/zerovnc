# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# HTTP port the agent listens on
PORT=8080

# Bearer token required on every endpoint (Authorization: Bearer <token>)
AGENT_BEARER_TOKEN=change-me

# OpenRouter API key (used from Phase 3 onward)
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Model IDs (Phase 3). Optional: the values below are the defaults. Changing a
# model must pass the component evals before use. Resolved IDs are logged at startup.
# PERCEPTION_MODEL=anthropic/claude-haiku-5.5
# PERCEPTION_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# DECISION_MODEL=jev-latest
# DECISION_FALLBACK_MODEL=openai/gpt-6-luna-decisions

# SQLite database file and artifact directory (screenshots, transcripts)
DATABASE_PATH=./data/agent.sqlite
ARTIFACT_DIR=./artifacts

# Hard limit per task, in milliseconds (challenge limit is 5 minutes)
TASK_TIMEOUT_MS=300000

# Eval harness only (not read by the server). Agent under test, the desktop
# given to each practice task, and the desktop's reset/check endpoints.
EVAL_AGENT_URL=http://localhost:8080
EVAL_AGENT_TOKEN=change-me
EVAL_DESKTOP_URL=wss://REPLACE_ME_DESKTOP_HOST/websockify
EVAL_DESKTOP_PASSWORD=REPLACE_ME
EVAL_DESKTOP_CHECK_URL=https://REPLACE_ME_DESKTOP_HOST
EVAL_DESKTOP_CHECK_TOKEN=REPLACE_ME
